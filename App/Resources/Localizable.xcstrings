    "Poke the bag and guess who's inside. A new bag every day, on your shelf at home.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッグをつついて、中の子を当てよう。毎日あたらしいバッグがホームのたなに届くよ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가방을 콕 찔러 보고 누가 들었는지 맞혀 봐. 매일 새 가방이 홈 선반에 와."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "戳戳袋子，猜猜裡面是誰。每天都有新袋子，就在主畫面的架子上。"
          }
        }
      }
    },
