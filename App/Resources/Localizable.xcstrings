          }
        }
      }
    },
    "3 spares! Swap them in your Collection.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダブりが3こ！コレクションで交換しよう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여분 3개! 컬렉션에서 교환해요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "3個多餘的！到收藏交換吧。"
          }
        }
      }
    },
    "3 stars: %lld moves or fewer": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "星3つ：%lld手以内"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "별 3개: %lld번 이하"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "3 顆星：%lld 步以內"
          }
        }
      }
    },
    "?": {
      "shouldTranslate": false
    },
    "A Christmas capsule!": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリスマスカプセルだ！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "크리스마스 캡슐이야!"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聖誕扭蛋！"
          }
        }
      }
    },
    "A bit of everything!": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ぜんぶ ちょっとずつ！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이것저것 다 나와요!"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "什麼都來一點！"
          }
        }
      }
    },
    "A bubble seals its jar. Dig under it until it meets its twin or the bottom. Pop!": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あわはびんにふたをするよ。下のスクイーズをどかして、同じなかまか底まで下ろすと、ポン！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비눗방울이 병을 막고 있어요. 아래 친구들을 꺼내서 같은 친구나 바닥에 닿으면 펑!"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "泡泡會把罐子封住。把下面的移走，讓它碰到同伴或罐底，就會啵地破掉！"
          }
        }
      }
    },
    "A golden bubble can fly! Tap it, then tap any jar.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "金色のあわはとべるよ！タップして、行きたいびんをタップしてね。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "황금 비눗방울은 날 수 있어요! 방울을 누르고, 보낼 병을 눌러요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "金色泡泡會飛！點一下泡泡，再點任何一個罐子。"
          }
        }
      }
    },
    "A keepsake for your Squish Room!": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクイッシュルームに記念品が届いたよ！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스퀴시 룸에 둘 기념품이에요!"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "送你一個放在捏捏房間的紀念品！"
          }
        }
      }
    },
    "A morph squishy! Every time you pour it, it flips to its other look.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "へんしんスクイーズ！うつすたびに、もうひとつのすがたに変わるよ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변신 스퀴시! 옮길 때마다 다른 모습으로 바뀌어요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "變身捏捏！每移動一次，就會變成另一個樣子。"
          }
        }
      }
    },
    "A spin jar! Tap its button and the jar turns upside down.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "くるりんジャー！ボタンをタップすると、さかさまになるよ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빙글 병! 버튼을 누르면 병이 거꾸로 뒤집혀요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "旋轉罐！點一下按鈕，罐子就會上下顛倒。"
