          }
        }
      }
    },
    "It never runs out. A capsule every fifth level.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おわりはありません。5レベルごとにカプセル。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끝이 없어요. 5레벨마다 캡슐이 나와요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "永遠玩不完。每五關一顆扭蛋。"
          }
