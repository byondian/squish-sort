    },
    "No way through from here. Undo a few moves.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここからはクリアできないよ。少しもどしてみよう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서는 더 갈 수 없어. 몇 수 되돌려 봐."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這樣走不通喔，退回幾步試試。"
          }
        }
      }
    },
    "Not high, not low. A rare one": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高くも低くもない。レアな子"
