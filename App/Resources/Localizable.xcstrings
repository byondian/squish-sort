        }
      }
    },
    "Duet Disco": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デュエットディスコ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "듀엣 디스코"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "二重唱迪斯可"
          }
        }
      }
    },
    "Duet! They move together. Land the bottom one on its own kind and they let go.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デュエット！ふたりはいっしょに動くよ。下の子を同じなかまの上におくと、手をはなすよ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "듀엣! 둘은 함께 움직여요. 아래 친구를 같은 종류 위에 놓으면 손을 놓아요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "二重唱！它們一起移動。把下面那個放到同類上，它們就會放手。"
          }
        }
      }
    },
    "EVERY %@ SQUISHY FOUND": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@のスクイーズをぜんぶ発見"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 스퀴시를 모두 찾았어요"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@的捏捏樂全部找到了"
