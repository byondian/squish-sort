    "What year were you born? This helps us show the right ads and settings.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何年生まれですか？あなたに合った広告と設定にするために使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "몇 년에 태어났나요? 알맞은 광고와 설정을 보여 주는 데 사용해요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你是哪一年出生的？這能幫助我們顯示合適的廣告與設定。"
          }
        }
      }
    },
    "Win a capsule to fill the Squish Room": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カプセルを当ててスクイーズルームをいっぱいにしよう"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캡슐을 얻어 스퀴시 룸을 채워 보세요"
