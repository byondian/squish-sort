      }
    },
    "Bubblegum": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バブルガム"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버블껌"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "泡泡糖"
          }
        }
      }
    },
    "Can I be your Buddy?": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バディになってもいい？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내가 네 버디가 되어도 돼?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我可以當你的夥伴嗎？"
          }
        }
      }
    },
    "Capsule next level!": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "つぎのレベルでカプセル！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 레벨에 캡슐!"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下一關有扭蛋！"
          }
        }
      }
    },
    "Capsule odds: rare %lld%%, ultra-rare %lld%%. Common squishies join when you sort a jar of them. Squishies are earned by playing and are never sold.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カプセルの確率：レア%1$lld%%、ウルトラレア%2$lld%%。コモンはびんをそろえると仲間になります。スクイーズはプレイでもらえます。販売はしていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캡슐 확률: 레어 %1$lld%%, 울트라 레어 %2$lld%%. 일반 스퀴시는 병을 완성하면 도감에 들어와요. 스퀴시는 플레이로만 얻을 수 있으며 판매하지 않아요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "扭蛋機率：稀有 %1$lld%%、超稀有 %2$lld%%。普通軟軟在排好一罐時加入圖鑑。軟軟只能靠遊玩獲得，絕不販售。"
          }
        }
      }
    },
    "Card full!": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カードがいっぱい！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카드 완성!"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "集滿了！"
          }
        }
      }
    },
    "Change Buddy": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バディをかえる"
          }
        },
        "ko": {
