    "Gentle mode: fewer, child-safe ads, purchases behind a grown-up check, no countdowns.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "やさしいモード：子ども向けの広告を少なめに、購入はおとなの確認つき、カウントダウンなし。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "순한 모드: 어린이에게 안전한 광고를 더 적게, 구매는 어른 확인 후, 카운트다운 없음."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "溫和模式：較少且適合兒童的廣告、購買需大人確認、沒有倒數計時。"
          }
        }
      }
    },
    "Get coins": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コインをゲット"
