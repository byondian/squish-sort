        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "高手關"
          }
        }
      }
    },
    "Each finished jar counts the tag down. At 0 the vine snaps!": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビンを1つそろえるたび、ふだの数字がへるよ。0でツルが切れる！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "병을 하나 완성할 때마다 꼬리표 숫자가 줄어요. 0이 되면 덩굴이 끊어져요!"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每完成一罐，吊牌數字就減一。到 0 藤蔓就會斷開！"
          }
        }
      }
    },
    "Ears": {
