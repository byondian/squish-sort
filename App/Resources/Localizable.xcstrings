{
  "sourceLanguage": "en",
  "strings": {
    "Ads removed. Thank you!": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "広告を削除しました。ありがとう！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "광고가 제거되었어요. 고마워요!"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "廣告已移除，謝謝你！"
          }
        }
      }
    },
    "Ask a grown-up": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おとなの人に聞いてね"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어른에게 물어보세요"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請問問大人"
          }
        }
      }
    },
