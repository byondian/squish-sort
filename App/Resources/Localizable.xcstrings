        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移除廣告"
          }
        }
      }
    },
    "Remove Ads stops forced ads. Squishies are never for sale.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「広告を削除」で強制広告がなくなります。スクイーズは販売していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "광고 제거를 구매하면 강제 광고가 사라져요. 스퀴시는 판매하지 않아요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移除廣告後不再出現強制廣告。軟軟絕不販售。"
          }
        }
      }
    },
