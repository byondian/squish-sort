        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "贏得扭蛋來填滿軟軟房間"
          }
        }
      }
    },
    "Win a level for a treat": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レベルをクリアするとおやつがもらえるよ"
          }
