{
  "sourceLanguage": "en",
  "strings": {
    "%@ asks:": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@からの質問："
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 질문:"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@想問："
          }
        }
      }
    },
    "%@ is your Buddy": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はきみのバディ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 네 버디야"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 是你的夥伴"
          }
        }
      }
    },
    "%@ joined your book!": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@がずかんに入ったよ！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 도감에 등록!"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@加入圖鑑了！"
          }
        }
      }
    },
    "%lld": {
      "shouldTranslate": false
    },
    "%lld coins": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld コイン"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코인 %lld개"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 金幣"
          }
        }
      }
    },
    "%lld coins for your milestone shelf.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイルストーンだなに%lldコイン。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마일스톤 선반 보상으로 코인 %lld개."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "里程碑架獎勵：%lld 金幣。"
          }
        }
      }
    },
    "%lld coins, %lld hints and the Golden Hour board. It is in the shop whenever you like.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コイン%1$lldまい、ヒント%2$lldこ、ボード「ゴールデンアワー」のセット。いつでもショップにあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코인 %1$lld개, 힌트 %2$lld개, 골든 아워 보드 세트. 언제든 상점에 있어요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 金幣、%2$lld 個提示和「黃金時刻」棋盤。隨時都在商店裡。"
          }
        }
      }
    },
    "%lld coins, %lld hints and the Golden Hour board. Once only.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コイン%1$lldまい、ヒント%2$lldこ、ボード「ゴールデンアワー」。1回かぎり。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코인 %1$lld개, 힌트 %2$lld개, 골든 아워 보드. 한 번만 살 수 있어요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 金幣、%2$lld 個提示和「黃金時刻」棋盤。限購一次。"
          }
        }
      }
    },
    "%lld free moves": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フリームーブ あと%lld回"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 이동 %lld회"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "免費 %lld 步"
          }
        }
      }
    },
    "%lld in a row! +%lld": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld連続！ +%2$lld"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld연속! +%2$lld"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連續 %1$lld 關！ +%2$lld"
          }
        }
      }
    },
    "%lld more for a capsule": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あと%lldこでカプセル"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캡슐까지 %lld개"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "再 %lld 顆可得扭蛋"
          }
        }
      }
    },
    "%lld more for a golden capsule": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あと%lldこでゴールドカプセル"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "황금 캡슐까지 %lld개"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "再 %lld 顆可得黃金扭蛋"
          }
        }
      }
    },
    "%lld more for coins": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あと%lldこでコイン"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코인까지 %lld개"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "再 %lld 顆可得金幣"
          }
        }
      }
    },
    "%lld more hearts to the next trick": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "つぎの芸まで ハートあと%lldこ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 재주까지 하트 %lld개"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "再 %lld 顆愛心學會新把戲"
          }
        }
      }
    },
    "%lld more levels to a capsule": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あと%lldレベルでカプセル"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캡슐까지 %lld레벨"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "再 %lld 關就有扭蛋"
          }
        }
      }
    },
    "%lld more levels. Opens after Morph Lab.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あと%lldレベル。へんしんラボのあとにひらくよ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레벨 %lld개 더. 변신 연구소 다음에 열려요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還有 %lld 關。完成變身實驗室後開放。"
          }
        }
      }
    },
    "%lld more stars": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スターあと%lldこ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "별 %lld개 더"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還差 %lld 顆星星"
          }
        }
      }
    },
    "%lld more stars open %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スターあと%1$lldこで%2$@がひらくよ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "별 %1$lld개 더 모으면 %2$@이(가) 열려요"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "再拿 %1$lld 顆星星就能開啟%2$@"
          }
        }
      }
    },
    "%lld more swaps for a new one": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あと%lldこで新しい子と交換"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld개 더 모으면 새 친구와 교환"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "再%lld個就能換新的"
          }
        }
      }
    },
    "%lld more: %lld coins": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あと%1$lldこ：%2$lldコイン"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld개 더: 코인 %2$lld개"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還差%1$lld個：%2$lld金幣"
          }
        }
      }
    },
    "%lld more: a secret squishy": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あと%lldこ：シークレットのスクイーズ"
          }
