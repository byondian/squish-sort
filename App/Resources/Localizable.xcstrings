    "%lld to the boss!": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボスまであと%lld！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보스까지 %lld판!"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "距離魔王還有%lld關！"
          }
        }
      }
    },
    "%lld treats for your Buddy!": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バディにおやつ%lldこ！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버디에게 간식 %lld개!"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "給夥伴 %lld 個點心！"
          }
        }
      }
    },
