{
  "sourceLanguage": "en",
  "strings": {
    "%@ asks:": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@からの質問："
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 질문:"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@想問："
          }
        }
      }
    },
    "%@ is your Buddy": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はきみのバディ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 네 버디야"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 是你的夥伴"
          }
        }
      }
    },
    "%@ joined your book!": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@がずかんに入ったよ！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 도감에 등록!"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@加入圖鑑了！"
          }
        }
      }
    },
    "%lld": {
      "shouldTranslate": false
    },
    "%lld coins": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld コイン"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코인 %lld개"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 金幣"
          }
        }
      }
    },
    "%lld free moves": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フリームーブ あと%lld回"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 이동 %lld회"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "免費 %lld 步"
          }
        }
      }
    },
    "%lld in a row! +%lld": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld連続！ +%2$lld"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld연속! +%2$lld"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連續 %1$lld 關！ +%2$lld"
          }
        }
      }
    },
    "%lld more for a capsule": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あと%lldこでカプセル"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캡슐까지 %lld개"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "再 %lld 顆可得扭蛋"
          }
        }
      }
    },
    "%lld more for a golden capsule": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あと%lldこでゴールドカプセル"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "황금 캡슐까지 %lld개"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "再 %lld 顆可得黃金扭蛋"
          }
        }
      }
    },
    "%lld more for coins": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あと%lldこでコイン"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코인까지 %lld개"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "再 %lld 顆可得金幣"
          }
        }
      }
    },
    "%lld more hearts to the next trick": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "つぎの芸まで ハートあと%lldこ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 재주까지 하트 %lld개"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "再 %lld 顆愛心學會新把戲"
          }
        }
      }
    },
    "%lld more levels to a capsule": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あと%lldレベルでカプセル"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캡슐까지 %lld레벨"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "再 %lld 關就有扭蛋"
          }
        }
      }
    },
    "%lld of %lld": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld / %2$lld"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld / %2$lld"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld / %2$lld"
          }
        }
      }
    },
    "%lld of %lld stars": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スター %1$lld / %2$lld"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "별 %1$lld / %2$lld"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "星星 %1$lld / %2$lld"
          }
        }
      }
    },
    "%lld treats for your Buddy!": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バディにおやつ%lldこ！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버디에게 간식 %lld개!"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "給夥伴 %lld 個點心！"
          }
        }
      }
    },
    "%lld/%lld": {
      "shouldTranslate": false
    },
    "+%lld": {
      "shouldTranslate": false
    },
    "+%lld coins!": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コイン+%lld！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코인 +%lld!"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "金幣 +%lld！"
          }
        }
      }
    },
    "+1 treat for %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@におやつ +1"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에게 간식 +1"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的點心 +1"
          }
        }
      }
    },
    "1 more level to a capsule": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あと1レベルでカプセル"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캡슐까지 1레벨"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "再 1 關就有扭蛋"
          }
        }
      }
    },
    "3 stars: %lld moves or fewer": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "星3つ：%lld手以内"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "별 3개: %lld번 이하"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "3 顆星：%lld 步以內"
          }
        }
      }
    },
    "?": {
      "shouldTranslate": false
    },
    "A Christmas capsule!": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリスマスカプセルだ！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "크리스마스 캡슐이야!"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聖誕扭蛋！"
          }
        }
      }
    },
    "Ads removed. Thank you!": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "広告を削除しました。ありがとう！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "광고가 제거되었어요. 고마워요!"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "廣告已移除，謝謝你！"
          }
        }
      }
    },
    "After level %lld": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レベル%lldのあと"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레벨 %lld 이후"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "第 %lld 關之後"
          }
        }
      }
    },
    "An extra guess wins coins. It doesn't fill the capsule bar.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加のこたえでもらえるのはコインだけ。カプセルバーは進みません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추가로 맞히면 코인만 받아요. 캡슐 바는 채워지지 않아요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "額外猜測只能獲得金幣，不會增加扭蛋進度。"
          }
        }
      }
    },
    "An extra jar gives you room to keep going.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビンを追加すると、続けられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "병을 추가하면 계속할 수 있어요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "多一個罐子就能繼續玩。"
          }
        }
      }
    },
