    "You have this sticker. All 5 boards this week give %lld more coins.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このシールは もう持っているよ。今週5つぜんぶクリアで さらに%lldコイン。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 스티커는 이미 있어요. 이번 주 보드 5개를 모두 깨면 %lld코인을 더 받아요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你已經有這張貼紙了。本週五關全破再送 %lld 金幣。"
          }
        }
