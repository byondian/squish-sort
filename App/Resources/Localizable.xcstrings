      }
    },
    "Win levels to earn coins too: 50 a win, 100 with three stars.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レベルをクリアしてもコインがもらえます。1回50、星3つで100。"
