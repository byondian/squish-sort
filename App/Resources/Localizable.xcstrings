    "Not quite. Try again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ちがうよ。もう一度。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아니에요. 다시 해 보세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不對喔，再試一次。"
          }
        }
      }
    },
    "Odds: common 70%, rare 25%, ultra-rare 5%. Squishies are earned by playing and are never sold.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確率：コモン70%、レア25%、ウルトラレア5%。スクイーズはプレイでもらえます。販売はしていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확률: 일반 70%, 레어 25%, 울트라 레어 5%. 스퀴시는 플레이로만 얻을 수 있으며 판매하지 않아요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "機率：普通 70%、稀有 25%、超稀有 5%。軟軟只能靠遊玩獲得，絕不販售。"
          }
        }
      }
    },
    "Opens 18 December": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "12月18日オープン"
          }
