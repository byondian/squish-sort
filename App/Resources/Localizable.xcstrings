    },
    "Your Buddy keeps every gift and wears it. Tap one it has to put it on or take it off.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バディはもらったプレゼントをずっともっていて、身につけます。もっているものをタップすると、つけたりはずしたりできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버디는 받은 선물을 모두 간직하고 착용해요. 가진 선물을 누르면 입히거나 벗길 수 있어요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "夥伴會留著每一份禮物並穿戴起來。點一下已有的禮物，就能戴上或拿下。"
          }
        }
      }
    },
    "Your Buddy lives at home. Give it treats and pats.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バディはホームにいるよ。おやつをあげて、なでてあげよう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버디는 홈에 살아요. 간식을 주고 쓰다듬어 주세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "夥伴住在主畫面。給牠點心，摸摸牠。"
          }
        }
      }
    },
    "Your first win each day earns a stamp.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎日さいしょのクリアでスタンプ1こ。"
