{
  "sourceLanguage": "en",
  "strings": {
    "%@ joined your book!": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@がずかんに入ったよ！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 도감에 등록!"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@加入圖鑑了！"
          }
        }
      }
    },
    "%lld": {
      "shouldTranslate": false
    },
    "%lld coins": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld コイン"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코인 %lld개"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 金幣"
          }
        }
      }
    },
    "%lld more levels to a capsule": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あと%lldレベルでカプセル"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캡슐까지 %lld레벨"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "再 %lld 關就有扭蛋"
          }
        }
      }
    },
    "%lld treats for your Buddy!": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バディにおやつ%lldこ！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버디에게 간식 %lld개!"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "給夥伴 %lld 個點心！"
          }
        }
      }
    },
    "%lld/%lld": {
      "shouldTranslate": false
    },
    "+%lld": {
      "shouldTranslate": false
    },
    "+%lld coins!": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コイン+%lld！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코인 +%lld!"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "金幣 +%lld！"
          }
        }
      }
    },
    "1 more level to a capsule": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あと1レベルでカプセル"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캡슐까지 1레벨"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "再 1 關就有扭蛋"
          }
        }
      }
    },
    "?": {
      "shouldTranslate": false
    },
    "A Christmas capsule!": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリスマスカプセルだ！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "크리스마스 캡슐이야!"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聖誕扭蛋！"
          }
        }
      }
    },
    "A deep squeak. A very rare one!": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "低い音。とてもレアな子！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "낮은 소리. 아주 희귀한 친구!"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "低沉的聲音。超稀有款！"
          }
        }
      }
    },
    "Ads removed. Thank you!": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "広告を削除しました。ありがとう！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "광고가 제거되었어요. 고마워요!"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "廣告已移除，謝謝你！"
          }
        }
      }
    },
    "An extra guess wins coins. It doesn't fill the capsule bar.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加のこたえでもらえるのはコインだけ。カプセルバーは進みません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추가로 맞히면 코인만 받아요. 캡슐 바는 채워지지 않아요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "額外猜測只能獲得金幣，不會增加扭蛋進度。"
          }
        }
      }
    },
    "An extra jar gives you room to keep going.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビンを追加すると、続けられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "병을 추가하면 계속할 수 있어요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "多一個罐子就能繼續玩。"
          }
        }
      }
    },
    "Answer": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "こたえ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "答案"
          }
        }
      }
    },
    "Ask a grown-up": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おとなの人に聞いてね"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어른에게 물어보세요"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請問問大人"
          }
        }
      }
    },
    "BOSS 👑": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボス 👑"
          }
        },
        "ko": {
